# =============================================================================
# Joplin Server - Coolify Configuration
# =============================================================================
# Copy this file to .env and update the values for your deployment
#
# IMPORTANT: Update these values before deploying to Coolify!
# =============================================================================

# Application Configuration
# -----------------------------------------------------------------------------
# APP_BASE_URL: The public URL where your Joplin server will be accessible
# Examples:
#   - https://joplin.yourdomain.com
#   - https://yourdomain.com/joplin
APP_BASE_URL=https://joplin.yourdomain.com

# APP_PORT: Internal port (default 22300, usually doesn't need to change)
APP_PORT=22300

# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection settings
# IMPORTANT: Change these credentials for production!
POSTGRES_USER=joplin
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DATABASE=joplin

# =============================================================================
# Optional: Advanced Configuration
# =============================================================================

# Uncomment and configure these if needed:

# Email Configuration (for password resets, notifications)
# MAILER_ENABLED=1
# MAILER_HOST=smtp.example.com
# MAILER_PORT=465
# MAILER_SECURITY=tls
# MAILER_AUTH_USER=your-email@example.com
# MAILER_AUTH_PASSWORD=your-email-password
# MAILER_NOREPLY_NAME=Joplin Server
# MAILER_NOREPLY_EMAIL=noreply@example.com

# Storage Configuration
# MAX_TIME_DRIFT=0
# STORAGE_DRIVER=Type::Database

# User Management
# USER_CONTENT_SIZE_LIMIT=
# MAX_ITEM_SIZE=

# For more configuration options, see:
# https://github.com/laurent22/joplin/blob/dev/readme/server/config.md
